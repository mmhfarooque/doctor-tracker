{
  "name": "doctor-tracker",
  "version": "1.0.0",
  "description": "Doctor Tracker - Healthcare Administrative Portal",
  "author": "Mahmud Farooque <me@mfaruk.com> (https://mfaruk.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/mmhfarooque/doctor-tracker.git"
  },
  "private": true,
  "scripts": {
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "seed": "cd server && npm run seed",
    "build:client": "cd client && npm run build",
    "install:all": "cd server && npm install && cd ../client && npm install",
    "test": "cd server && npm test",
    "sync-indexes": "cd server && npm run sync-indexes",
    "lint": "cd server && npm run lint && cd ../client && npm run lint"
  },
  "engines": {
    "node": ">=20.9"
  }
}
