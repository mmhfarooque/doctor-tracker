diff --git a/server/src/utils/auditedMutation.js b/server/src/utils/auditedMutation.js
new file mode 100644
index 0000000..35c4fb2
--- /dev/null
+++ b/server/src/utils/auditedMutation.js
@@ -0,0 +1,25 @@
+import mongoose from 'mongoose';
+
+// Mongoose propagates the transaction session to every operation in the callback.
+mongoose.set('transactionAsyncLocalStorage', true);
+
+/** Send success only after both clinical writes and their audit entries commit. */
+export const auditedMutation = (handler) => async (req, res, next) => {
+  try {
+    let status = 200;
+    let body;
+    const reply = {
+      status(code) { status = code; return this; },
+      json(value) { body = value; return this; },
+    };
+    await mongoose.connection.transaction(async () => {
+      // A transaction callback can be retried by MongoDB.
+      status = 200;
+      body = undefined;
+      await handler(req, reply, (err) => { throw err; });
+    });
+    res.status(status).json(body);
+  } catch (err) {
+    next(err);
+  }
+};
diff --git a/server/src/utils/rateLimitStore.js b/server/src/utils/rateLimitStore.js
new file mode 100644
index 0000000..64815ac
--- /dev/null
+++ b/server/src/utils/rateLimitStore.js
@@ -0,0 +1,33 @@
+import mongoose from 'mongoose';
+
+/** Shared counters survive serverless instance recycling. */
+export class MongoRateLimitStore {
+  constructor(namespace) {
+    this.namespace = namespace;
+    this.localKeys = false;
+  }
+  init({ windowMs }) { this.windowMs = windowMs; }
+  get collection() { return mongoose.connection.collection('rate_limits'); }
+  bucket(key) {
+    const window = Math.floor(Date.now() / this.windowMs);
+    return { id: `${this.namespace}:${window}:${key}`, resetTime: new Date((window + 1) * this.windowMs) };
+  }
+  async increment(key) {
+    const { id, resetTime } = this.bucket(key);
+    this.ready ??= this.collection.createIndex({ expiresAt: 1 }, { expireAfterSeconds: 0 }).catch((err) => {
+      this.ready = null;
+      throw err;
+    });
+    await this.ready;
+    const result = await this.collection.findOneAndUpdate(
+      { _id: id },
+      { $inc: { hits: 1 }, $setOnInsert: { expiresAt: resetTime } },
+      { upsert: true, returnDocument: 'after', includeResultMetadata: false }
+    );
+    return { totalHits: result.hits, resetTime };
+  }
+  async decrement(key) {
+    await this.collection.updateOne({ _id: this.bucket(key).id, hits: { $gt: 0 } }, { $inc: { hits: -1 } });
+  }
+  async resetKey(key) { await this.collection.deleteOne({ _id: this.bucket(key).id }); }
+}
